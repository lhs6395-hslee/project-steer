{
  "permissions": {
    "allow": [
      "mcp__google-workspace__get_gmail_thread_content",
      "mcp__google-workspace__get_gmail_messages_content_batch",
      "mcp__google-workspace__search_gmail_messages",
      "mcp__google-workspace__list_gmail_labels",
      "mcp__google-workspace__list_gmail_filters",
      "mcp__google-workspace__send_gmail_message",
      "mcp__google-workspace__batch_modify_gmail_message_labels",
      "mcp__google-workspace__manage_gmail_label",
      "mcp__google-workspace__manage_gmail_filter",
      "mcp__google-workspace__draft_gmail_message",
      "mcp__13a256e9-97e6-4bc0-b47e-e111540f2b0e__search_threads",
      "mcp__13a256e9-97e6-4bc0-b47e-e111540f2b0e__get_thread",
      "mcp__dooray__dooray_search_members",
      "mcp__dooray__dooray_get_task",
      "mcp__scheduled-tasks__list_scheduled_tasks",
      "mcp__scheduled-tasks__create_scheduled_task",
      "mcp__scheduled-tasks__update_scheduled_task"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sync-to-platforms.sh && echo 'Harness Pipeline active. Use @planner, @executor, @reviewer subagents directly.'"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: Harness pipeline mandatory for all module tasks. Read PROJECT.md. Config: .mcp.json (primary) → Kiro/Antigravity (sync)'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cat | \"$CLAUDE_PROJECT_DIR\"/scripts/agents/guardian.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(cat | jq -r '.tool_input.file_path // empty'); if [[ \"$FILE\" == .mcp.json ]] || [[ \"$FILE\" == .claude/settings* ]]; then \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sync-to-platforms.sh; fi; if [[ \"$FILE\" == modules/* ]] || [[ \"$FILE\" == skills/* ]]; then \"$CLAUDE_PROJECT_DIR\"/scripts/agents/kairos.sh \"$FILE\" 2>/dev/null || true; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat | \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pipeline-check.sh"
          }
        ]
      }
    ]
  }
}
